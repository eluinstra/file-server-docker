# DEMO / DEVELOPMENT VALUES ONLY — for the local docker-compose example in this
# directory. These credentials and the bundled test keystores are NOT for
# production and provide no security. Before any non-local run, replace every
# value below (and the keystores) with strong, per-environment secrets supplied
# via your own environment / secret store — never commit real credentials.
FILE_SERVER_VERSION=2.1.1
FILE_CLIENT_VERSION=2.1.1
FILE_SERVER_DB_NAME=file-server
FILE_SERVER_DB_USER=file-server
FILE_SERVER_DB_PASSWORD=file-server
FILE_CLIENT_DB_NAME=file-client
FILE_CLIENT_DB_USER=file-client
FILE_CLIENT_DB_PASSWORD=file-client
